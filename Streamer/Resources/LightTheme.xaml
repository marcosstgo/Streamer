<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme overrides: same keys as dark theme -->
    <SolidColorBrush x:Key="BgPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#5865F2"/>
    <SolidColorBrush x:Key="AccentHover" Color="#4752C4"/>
    <SolidColorBrush x:Key="Success" Color="#2EA44F"/>
    <SolidColorBrush x:Key="Danger" Color="#D32F2F"/>
    <SolidColorBrush x:Key="Warning" Color="#B07A02"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#192129"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

</ResourceDictionary>