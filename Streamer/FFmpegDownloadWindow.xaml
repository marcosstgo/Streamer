<Window x:Class="Streamer.FFmpegDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource str_ffmpeg_win_title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F1720"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{DynamicResource str_ffmpeg_required}" FontSize="18" FontWeight="SemiBold"
                   Foreground="#E6EDF3" Margin="0,0,0,8"/>

        <!-- Description -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="#9CA6B2"
                   Margin="0,0,0,12"
                   Text="{DynamicResource str_ffmpeg_desc}"/>

        <!-- Version info -->
        <Border Grid.Row="2" Background="#141C26" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource str_ffmpeg_version_label}" FontSize="12" Foreground="#6B7683" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Text="{DynamicResource str_ffmpeg_checking}" FontSize="12"
                           Foreground="#F5B72E" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Consolas"/>
                <TextBlock Text=" · fuente: gyan.dev" FontSize="11" Foreground="#4A3045"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status text -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="{DynamicResource str_ffmpeg_ready}"
                   FontSize="12" Foreground="#9CA6B2" VerticalAlignment="Center"/>

        <!-- Success banner (hidden until complete) -->
        <Border x:Name="SuccessBanner" Grid.Row="3" Background="#0D2B1A" CornerRadius="8"
                Padding="12,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#05FF74"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource str_ffmpeg_installed}" FontSize="13"
                               FontWeight="SemiBold" Foreground="#05FF74"/>
                    <TextBlock Text="{DynamicResource str_ffmpeg_ready_use}" FontSize="11"
                               Foreground="#6B7683" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress bar -->
        <ProgressBar x:Name="DownloadProgress" Grid.Row="4"
                     Height="8" Minimum="0" Maximum="100" Value="0"
                     Margin="0,8,0,20"
                     Background="#141C26" BorderThickness="0">
            <ProgressBar.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F5B72E" Offset="0"/>
                    <GradientStop Color="#FFD060" Offset="1"/>
                </LinearGradientBrush>
            </ProgressBar.Foreground>
            <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="{DynamicResource str_cancel}" Width="90" Height="32"
                    Margin="0,0,10,0" Click="CancelBtn_Click"
                    Background="Transparent" Foreground="#9CA6B2"
                    BorderBrush="#2A3441" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="DownloadBtn" Content="{DynamicResource str_download}" Width="110" Height="32"
                    Click="DownloadBtn_Click" Cursor="Hand" IsEnabled="False"
                    Background="#F5B72E" Foreground="Black"
                    BorderThickness="0" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC94A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
