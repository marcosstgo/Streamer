<Window x:Class="Streamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Streamer Pro"
        Height="990" Width="1080"
        MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="#0F1720"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontFamilyPrimary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel Margin="20" Background="{StaticResource BgPrimary}">

        <!-- ====== BOTTOM-PINNED SECTIONS (DockPanel.Dock="Bottom") ====== -->

        <!-- Footer credits (pinned at very bottom) -->
        <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="4,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center">
                    Desarrollado por Marcos Santiago · FFmpeg es software independiente
                </TextBlock>

                <Button Grid.Column="1" x:Name="CreditsButton" Content="Créditos" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="CreditsButton_Click"/>
            </Grid>
        </Border>


        <!-- Footer / Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status pill -->
                <Border Grid.Column="0" Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StreamStatus" Width="10" Height="10" Fill="{StaticResource DangerRed}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StreamStatusText" Text="Detenido" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Live metrics inline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bitrate:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricBitrate" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="FPS:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricFps" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="CPU:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricCpu" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="MEM:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricMem" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="GPU:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricGpu" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Speed:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="MetricSpeed" Text="--" Foreground="{StaticResource SparklineCPU}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Stream time -->
                <TextBlock Grid.Column="2" x:Name="StreamTime" Text="00:00:00" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="13"/>

                <!-- Right action buttons -->
                <Button Grid.Column="3" x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶ Iniciar" Padding="12,6" FontSize="12" Margin="0,0,6,0" Click="StartStream_Click"/>
                <Button Grid.Column="4" x:Name="StopButton" Style="{StaticResource DangerButton}" Content="■ Detener" Padding="12,6" FontSize="12" Margin="0,0,6,0" Click="StopStream_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- ====== SCROLLABLE CONTENT (fills remaining space) ====== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Header / Topbar -->
                <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16,14" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Image Source="/streamerpro.png" Width="52" Height="52" Margin="0,0,16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Streamer Pro" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Style="{StaticResource BadgeStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionBadge" Text="v2.0.2" FontWeight="Bold" Foreground="Black" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Streaming profesional simplificado" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource InputBg}" CornerRadius="16" Padding="10,6" Margin="0,0,10,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ServerIndicator" Width="10" Height="10" Fill="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ServerStatusText" Text="Servidor: --" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="ServerLatencyText" Text="--" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource InputBg}" CornerRadius="16" Padding="10,6" Margin="0,0,10,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FFmpegIndicator" Width="10" Height="10" Fill="{StaticResource StatusGreen}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="FFmpegStatusText" Text="FFmpeg: Detectado" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Config + Advanced options side by side -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                <!-- Configuración de Transmisión -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="📡 Configuración de Transmisión" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plataforma" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PlatformCombo" Style="{StaticResource ComboBoxStyle}" Foreground="Black" Height="28" SelectionChanged="PlatformCombo_SelectionChanged" ToolTip="Selecciona una plataforma o usa Personalizado">
                                <ComboBoxItem Content="Corillo.live" Tag="rtmp://corillo.live/live/" IsSelected="True"/>
                                <ComboBoxItem Content="Twitch" Tag="rtmp://live.twitch.tv/app/"/>
                                <ComboBoxItem Content="YouTube" Tag="rtmp://a.rtmp.youtube.com/live2/"/>
                                <ComboBoxItem Content="Kick" Tag="" ToolTip="Pega tu URL de ingest desde kick.com/dashboard/settings/stream"/>
                                <ComboBoxItem Content="Facebook" Tag="rtmps://live-api-s.facebook.com:443/rtmp/"/>
                                <ComboBoxItem Content="Personalizado" Tag=""/>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Stream Key" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Grid Grid.Row="0" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="StreamKeyHidden" Grid.Column="0" PasswordChar="&#x25CF;" Style="{StaticResource PasswordBoxStyle}" ToolTip="Stream Key" LostFocus="StreamKey_LostFocus"/>
                                <TextBox x:Name="StreamKey" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Stream Key" Visibility="Collapsed" LostFocus="StreamKey_LostFocus"/>
                                <Button x:Name="ToggleKeyBtn" Grid.Column="1" Content="👁" Width="30" Height="28" Margin="4,0,0,0" Cursor="Hand" Click="ToggleStreamKey_Click" ToolTip="Mostrar/Ocultar Stream Key" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="14"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Servidor RTMP" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RTMPBase" Text="rtmp://corillo.live/live/" Style="{StaticResource TextBoxStyle}" LostFocus="RTMPBase_LostFocus" ToolTip="URL del servidor RTMP"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Modo de Fuente" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                                <RadioButton x:Name="ModeOnline" Content="🌐 Fuentes online" IsChecked="True" Margin="0,0,12,0" Style="{StaticResource RadioButtonStyle}" ToolTip="Reproduce directamente desde una URL online"/>
                                <RadioButton x:Name="ModeFolder" Content="📁 Carpeta local (playlist)" Style="{StaticResource RadioButtonStyle}" ToolTip="Reproduce una carpeta local como playlist"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Fuente" Style="{StaticResource LabelStyle}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Grid.ColumnSpan="3">
                                <ComboBox x:Name="SourceCombo" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" Height="34" IsEnabled="{Binding IsOnlineMode}" DisplayMemberPath="DisplayText" HorizontalAlignment="Stretch" Foreground="Black">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ComboBoxItem}">
                                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="SourceStatusText" Text="Cargando fuentes..." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" Value="Listo">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="OpenSourcesButton" Content="Abrir carpeta de fuentes" Style="{StaticResource SecondaryButton}" Margin="12,0,6,0" Padding="8,4" Click="OpenSourcesButton_Click" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeOnline}"/>
                                    <Button x:Name="ReloadSourcesButton" Content="Recargar fuentes" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="ReloadSourcesButton_Click" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeOnline}"/>
                                </StackPanel>

                                <!-- Folder controls -->
                                <StackPanel Orientation="Vertical" Margin="0,12,0,0" x:Name="FolderControls" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeFolder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SelectedFolderText" Grid.Column="0" IsReadOnly="True" Style="{StaticResource TextBoxStyle}"/>
                                        <Button x:Name="SelectFolderButton" Grid.Column="1" Content="Seleccionar carpeta..." Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="SelectFolderButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6">
                                            <CheckBox x:Name="FolderLoopCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="Repetir la playlist indefinidamente">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔁" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                    <TextBlock Text="Loop playlist" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>

                                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6">
                                            <CheckBox x:Name="FolderRandomCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="Reproducir los archivos en orden aleatorio">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔀" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                    <TextBlock Text="Randomize playlist" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Opciones Avanzadas (right column) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="⚙️ Opciones Avanzadas" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ForceYUV" Content="Forzar YUV420p" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                        <CheckBox x:Name="HardwareAccel" Content="Hardware Acceleration" Style="{StaticResource CheckBoxStyle}"/>
                        <CheckBox x:Name="LoopInfinite" Content="Loop Infinito" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                        <CheckBox x:Name="Notifications" Content="Notificaciones" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                        <CheckBox x:Name="ShowFFmpegCommand" Content="Mostrar Comandos (FFmpeg)" Style="{StaticResource CheckBoxStyle}"/>
                        <CheckBox x:Name="SaveLogs" Content="Guardar Logs" Style="{StaticResource CheckBoxStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Duración máx. (seg)" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="MaxDuration" Text="0" Style="{StaticResource TextBoxStyle}" Width="60" ToolTip="0 = infinito"/>
                            <TextBlock Text="∞" Foreground="{StaticResource TextMuted}" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- Row 2: Perfiles de calidad + Action buttons -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                        <StackPanel>
                            <TextBlock Text="⚡ Perfiles de calidad" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="5" Margin="0,10,0,0" Rows="1">
                                <Button x:Name="Profile480p" Style="{StaticResource SecondaryButton}" Content="480p - Bajo" Margin="0,0,6,0" Tag="480p" Click="ProfileButton_Click" FontSize="12"/>
                                <Button x:Name="Profile720p" Style="{StaticResource SecondaryButton}" Content="720p - Medio" Margin="0,0,6,0" Tag="720p" Click="ProfileButton_Click" FontSize="12"/>
                                <Button x:Name="Profile1080p" Style="{StaticResource PrimaryButton}" Content="1080p - Alto" Margin="0,0,6,0" Tag="1080p" Click="ProfileButton_Click" FontSize="12"/>
                                <Button x:Name="Profile1080p60" Style="{StaticResource SecondaryButton}" Content="1080p60 - Fluido" Margin="0,0,6,0" Tag="1080p60" Click="ProfileButton_Click" FontSize="12"/>
                                <Button x:Name="ProfileCustom" Style="{StaticResource SecondaryButton}" Content="Personalizado" Margin="0" Click="ProfileCustom_Click" FontSize="12"/>
                            </UniformGrid>

                            <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Style="{StaticResource FieldContainer}" Margin="0,0,10,0">
                                        <TextBlock Text="Video Bitrate" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="VideoBitrateManual" Text="4500k" Style="{StaticResource TextBoxStyle}" Width="112"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource FieldContainer}" Margin="10,0,10,0">
                                        <TextBlock Text="Audio Bitrate" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="AudioBitrateManual" Text="160k" Style="{StaticResource TextBoxStyle}" Width="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource FieldContainer}" Margin="0,0,10,0">
                                        <TextBlock Text="Preset" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="PresetCombo" Style="{StaticResource ComboBoxStyle}" SelectedIndex="4" Foreground="Black" Height="28">
                                            <ComboBoxItem Content="ultrafast"/>
                                            <ComboBoxItem Content="superfast"/>
                                            <ComboBoxItem Content="veryfast"/>
                                            <ComboBoxItem Content="faster"/>
                                            <ComboBoxItem Content="fast"/>
                                            <ComboBoxItem Content="medium"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Resolución/FPS" Style="{StaticResource LabelStyle}" Width="107"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ResolutionManual" Grid.Column="0" Text="1920x1080" Style="{StaticResource TextBoxStyle}" Grid.ColumnSpan="3" Margin="-2,4,44,4"/>
                                            <TextBlock Grid.Column="2" Text="@" VerticalAlignment="Center" Margin="19,0,30,0" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBox x:Name="FPSManual" Grid.Column="2" Text="30" Style="{StaticResource TextBoxStyle}" Margin="20,4,-10,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons column -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button x:Name="StartBig" Style="{StaticResource BigPrimaryButton}" Content="(•)) Iniciar Stream" Click="StartStream_Click" Width="193" Height="44" Margin="0,0,0,10"/>
                        <Button x:Name="StopBig" Style="{StaticResource BigDangerButton}" Content="■ Detener" Click="StopStream_Click" IsEnabled="False" Width="196" Height="44" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏱" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StreamTimeCompact" Text="00:00:00" Foreground="{StaticResource TextSecondary}" FontFamily="{DynamicResource MonoFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="VideoHealthIndicator" Width="8" Height="8" Fill="{StaticResource StatusGreen}" Margin="0,0,6,0" Visibility="Hidden"/>
                            <TextBlock x:Name="VideoHealthText" Text="En vivo" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Hidden"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Favoritos -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⭐ Favoritos" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveFavoriteButton" Style="{StaticResource SecondaryButton}" Content="Guardar actual" Padding="10,5" FontSize="12" Click="SaveFavorite_Click"/>
                                <Button x:Name="DeleteFavoriteButton" Style="{StaticResource DangerButton}" Content="Eliminar" Padding="10,5" FontSize="12" Margin="8,0,0,0" Click="DeleteFavorite_Click"/>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="FavoritesList" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" Margin="0,10,0,0" SelectionChanged="FavoritesList_SelectionChanged" Foreground="{StaticResource TextPrimary}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended" MaxHeight="80" Padding="4"/>
                    </StackPanel>
                </Border>

                <!-- Últimos streams -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="📋 Últimos streams" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ListBox x:Name="HistoryList" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FontFamily="{DynamicResource MonoFont}" MaxHeight="120" FontSize="12" Padding="4"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>