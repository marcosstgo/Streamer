<Window x:Class="Streamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Streamer Pro"
        Height="990" Width="1200"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F1720"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontFamilyPrimary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel Margin="20" Background="{StaticResource BgPrimary}">

        <!-- ====== BOTTOM-PINNED SECTIONS (DockPanel.Dock="Bottom") ====== -->

        <!-- Footer credits (pinned at very bottom) -->
        <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="4,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Text="{DynamicResource str_footer_credit}"/>

                <Button Grid.Column="1" x:Name="CreditsButton" Content="{DynamicResource str_credits_btn}" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="CreditsButton_Click"/>
            </Grid>
        </Border>


        <!-- Footer / Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#101925" CornerRadius="16" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status pill -->
                <Border Grid.Column="0" Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StreamStatus" Width="10" Height="10" Fill="{StaticResource DangerRed}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StreamStatusText" Text="{DynamicResource str_status_stopped}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Live metrics inline -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" Margin="0,0,8,0" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BITRATE" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricBitrate" Text="--" Foreground="{StaticResource AccentYellow}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" Margin="0,0,8,0" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricFps" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" Margin="0,0,8,0" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricCpu" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" Margin="0,0,8,0" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MEM" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricMem" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" Margin="0,0,8,0" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricGpu" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0B131D" CornerRadius="10" Padding="8,6" BorderBrush="#27384A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPEED" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MetricSpeed" Text="--" Foreground="{StaticResource SparklineCPU}" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Stream time -->
                <TextBlock Grid.Column="2" x:Name="StreamTime" Text="00:00:00" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="12.5"/>

                <!-- Right action buttons -->
                <Button Grid.Column="3" x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶ Start" Padding="10,5" FontSize="11" Margin="0,0,6,0" Opacity="0.82" Click="StartStream_Click"/>
                <Button Grid.Column="4" x:Name="StopButton" Style="{StaticResource DangerButton}" Content="■ Stop" Padding="10,5" FontSize="11" Margin="0,0,6,0" Opacity="0.82" Click="StopStream_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- ====== SCROLLABLE CONTENT (fills remaining space) ====== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Header / Topbar -->
                <Border Background="{StaticResource HeaderGradient}" CornerRadius="18" Padding="18,16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="15" Background="#0D1621" BorderBrush="#33465E" BorderThickness="1" Margin="0,0,16,0">
                                <Image Source="/streamerpro.png" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Streamer Pro" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Style="{StaticResource BadgeStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionBadge" Text="v2.0.2" FontWeight="Bold" Foreground="Black" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource str_tagline}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock Text="Control room for live, local and capture streaming." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0D1621" CornerRadius="18" Padding="12,8" Margin="0,0,10,0" BorderBrush="#324256" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ServerIndicator" Width="10" Height="10" Fill="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ServerStatusText" Text="Servidor: --" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="ServerLatencyText" Text="--" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="FFmpegPill" Background="#0D1621" CornerRadius="18" Padding="12,8" Margin="0,0,10,0" BorderBrush="#324256" BorderThickness="1" MouseLeftButtonUp="FFmpegPill_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FFmpegIndicator" Width="10" Height="10" Fill="{StaticResource StatusGreen}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="FFmpegStatusText" Text="FFmpeg: Detectado" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Update badge (hidden until update available) -->
                            <Border x:Name="UpdateBadge" Background="#F5B72E" CornerRadius="16" Padding="10,6" Margin="0,0,10,0" Visibility="Collapsed" MouseLeftButtonUp="UpdateBadge_Click" Cursor="Hand" ToolTip="{DynamicResource str_update_tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑" Foreground="Black" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock x:Name="UpdateBadgeText" Text="v0.0.0 disponible" Foreground="Black" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Theme toggle button -->
                            <Button x:Name="ThemeToggleBtn"
                                    Margin="10,0,0,0"
                                    Padding="12,8"
                                    Click="ThemeToggleBtn_Click"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource str_theme_tooltip}"
                                    Background="#0D1621"
                                    BorderBrush="#324256">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="16"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="ArcStripes" Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" Visibility="Collapsed">
                                        <Rectangle Width="3" Height="11" Fill="#D00000" Margin="0,0,2,0" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="11" Fill="#FFEA00" Margin="0,0,2,0" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="11" Fill="#05FF74" Margin="0,0,2,0" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="11" Fill="#5FFFFF" RadiusX="1" RadiusY="1"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ThemeToggleText" Text="◈ ARC"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#00BFBF"/>
                                </StackPanel>
                            </Button>

                            <!-- Language toggle button -->
                            <Button x:Name="LangToggleBtn"
                                    Margin="6,0,0,0"
                                    Padding="12,8"
                                    Click="LangToggleBtn_Click"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource str_lang_tooltip}"
                                    Background="#0D1621"
                                    BorderBrush="#324256">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="16"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="LangToggleText" Text="{DynamicResource str_lang_btn}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Config + Advanced options side by side -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                <!-- Configuración de Transmisión -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource str_section_config}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                        <!-- DESTINO -->
                        <TextBlock Text="{DynamicResource str_label_destination}" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_label_platform}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PlatformCombo" Style="{StaticResource ComboBoxStyle}" Height="34" SelectionChanged="PlatformCombo_SelectionChanged" ToolTip="{DynamicResource str_tooltip_platform_combo}">
                                <ComboBoxItem Content="Corillo.live" Tag="rtmp://corillo.live/live/" IsSelected="True"/>
                                <ComboBoxItem Content="Twitch" Tag="rtmp://live.twitch.tv/app/"/>
                                <ComboBoxItem Content="YouTube" Tag="rtmp://a.rtmp.youtube.com/live2/"/>
                                <ComboBoxItem Content="Kick" Tag="" ToolTip="{DynamicResource str_tooltip_kick}"/>
                                <ComboBoxItem Content="Facebook" Tag="rtmps://live-api-s.facebook.com:443/rtmp/"/>
                                <ComboBoxItem Content="{DynamicResource str_custom}" Tag=""/>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Stream Key" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Grid Grid.Row="0" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="StreamKeyHidden" Grid.Column="0" PasswordChar="&#x25CF;" Style="{StaticResource PasswordBoxStyle}" ToolTip="Stream Key" LostFocus="StreamKey_LostFocus"/>
                                <TextBox x:Name="StreamKey" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Stream Key" Visibility="Collapsed" LostFocus="StreamKey_LostFocus"/>
                                <Button x:Name="ToggleKeyBtn" Grid.Column="1" Content="👁" Width="30" Height="28" Margin="4,0,0,0" Cursor="Hand" Click="ToggleStreamKey_Click" ToolTip="{DynamicResource str_streamkey_toggle}" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="14"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_label_rtmp}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RTMPBase" Text="rtmp://corillo.live/live/" Style="{StaticResource TextBoxStyle}" LostFocus="RTMPBase_LostFocus" ToolTip="{DynamicResource str_tooltip_rtmp}"/>
                        </Grid>

                        <!-- FUENTE -->
                        <TextBlock Text="{DynamicResource str_label_source}" Style="{StaticResource SectionLabel}"/>
                        <Border Background="#0E1823" CornerRadius="16" BorderBrush="#2A3B4E" BorderThickness="1" Padding="8" Margin="0,2,0,8">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="ModeOnline" IsChecked="True" Style="{StaticResource ModeCardButton}" ToolTip="{DynamicResource str_tooltip_online}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Online" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock Text="Live sources" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeFolder" Style="{StaticResource ModeCardButton}" ToolTip="{DynamicResource str_tooltip_folder}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource str_mode_folder}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock Text="Playlist folders" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeFile" Style="{StaticResource ModeCardButton}" ToolTip="{DynamicResource str_tooltip_file}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource str_mode_file}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock Text="Single clip" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeCapture" Style="{StaticResource ModeCardButton}" ToolTip="{DynamicResource str_tooltip_capture}" Checked="ModeCapture_Checked" Margin="0">
                                <Grid>
                                    <!-- BETA badge -->
                                    <Border Background="{DynamicResource AccentYellow}" CornerRadius="4" Padding="3,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                        <TextBlock Text="BETA" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="🎮" FontSize="17" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_mode_capture}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        <TextBlock Text="Display capture" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                        </Border>

                        <!-- Dynamic source controls -->
                        <StackPanel>
                            <!-- Online controls -->
                            <ComboBox x:Name="SourceCombo" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" Height="34" IsEnabled="{Binding IsOnlineMode}" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeOnline}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimary}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Border Background="#0E1823" CornerRadius="12" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" Padding="10,8" Margin="0,6,0,0" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeOnline}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="SourceStatusText" Text="{DynamicResource str_loading_sources}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="OpenSourcesButton" Content="{DynamicResource str_open_sources}" Style="{StaticResource SecondaryButton}" Margin="12,0,6,0" Padding="8,4" Click="OpenSourcesButton_Click"/>
                                        <Button x:Name="ReloadSourcesButton" Content="{DynamicResource str_reload_sources}" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="ReloadSourcesButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Folder controls -->
                            <StackPanel x:Name="FolderControls" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeFolder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SelectedFolderText" Grid.Column="0" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" Text="{Binding SelectedFolderPath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button x:Name="SelectFolderButton" Grid.Column="1" Content="{DynamicResource str_select_folder}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="SelectFolderButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="HlPrimaryFolderHint" Text="{DynamicResource str_primary_folder_hint}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,4,0,0" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6">
                                        <CheckBox x:Name="FolderLoopCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="{DynamicResource str_tooltip_loop}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔁" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="Loop playlist" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6" Margin="8,0,0,0">
                                        <CheckBox x:Name="FolderRandomCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="{DynamicResource str_tooltip_random}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔀" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="Randomize playlist" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6" Margin="8,0,0,0">
                                        <CheckBox x:Name="FolderWaitCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="{DynamicResource str_tooltip_wait}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⏳" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="{DynamicResource str_wait_mode}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6" Margin="8,0,0,0">
                                        <CheckBox x:Name="FolderHighlightsCheck" Style="{StaticResource CheckBoxStyle}" ToolTip="{DynamicResource str_tooltip_highlight}" Checked="FolderHighlightsCheck_Changed" Unchecked="FolderHighlightsCheck_Changed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⭐" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="Highlight" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                                <!-- Panel carpetas adicionales -->
                                <Border x:Name="HlExtraFoldersPanel" Background="{StaticResource BgCard}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource str_extra_folders}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <StackPanel x:Name="HlFoldersList"/>
                                        <Button x:Name="HlAddFolderButton" Content="{DynamicResource str_add_folder}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="8,4" FontSize="11" Margin="0,6,0,0" Click="HlAddFolderButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- File controls -->
                            <StackPanel x:Name="FileControls" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeFile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SelectedFileText" Grid.Column="0" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" ToolTip="{DynamicResource str_tooltip_file_sel}"/>
                                    <Button x:Name="SelectFileButton" Grid.Column="1" Content="{DynamicResource str_select_file}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="SelectFileButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Capture controls -->
                            <StackPanel x:Name="CaptureControls" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=ModeCapture}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Monitor" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CaptureMonitorCombo" Grid.Column="1" Style="{StaticResource ComboBoxStyle}" Height="34"/>
                                    <Button x:Name="CapturePreviewBtn" Grid.Column="2" Content="{DynamicResource str_preview_btn}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="8,4" Click="CapturePreviewBtn_Click"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="FPS" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="CaptureFps30" Content="30" GroupName="CaptureFps" Style="{StaticResource RadioButtonStyle}" Margin="0,0,12,0"/>
                                            <RadioButton x:Name="CaptureFps60" Content="60" GroupName="CaptureFps" IsChecked="True" Style="{StaticResource RadioButtonStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="6" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="CaptureAudioCheck" IsChecked="True" Style="{StaticResource CheckBoxStyle}" ToolTip="{DynamicResource str_tooltip_audio}">
                                                <TextBlock Text="🔊" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13"/>
                                            </CheckBox>
                                            <ComboBox x:Name="CaptureAudioDeviceCombo" Style="{StaticResource ComboBoxStyle}" Height="28" MinWidth="200" VerticalAlignment="Center" ToolTip="{DynamicResource str_tooltip_audio_dev}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Opciones Avanzadas (right column) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource str_section_advanced}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Engine and runtime behavior for streams." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,0,0,10"/>

                        <!-- VIDEO -->
                        <TextBlock Text="VIDEO" Style="{StaticResource SectionLabel}" Margin="0,8,0,4"/>
                        <Border Background="#0E1823" CornerRadius="12" Padding="9" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ForceYUV" Content="{DynamicResource str_force_yuv}" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="HardwareAccel" Content="Hardware Acceleration" Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- STREAM -->
                        <TextBlock Text="STREAM" Style="{StaticResource SectionLabel}"/>
                        <Border Background="#0E1823" CornerRadius="12" Padding="9" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="LoopInfinite" Content="{DynamicResource str_loop_infinite}" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                                    <TextBlock Text="{DynamicResource str_loop_local_note}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="Notifications" Content="{DynamicResource str_notifications}" IsChecked="True" Style="{StaticResource CheckBoxStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{DynamicResource str_max_duration}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="MaxDuration" Text="0" Style="{StaticResource TextBoxStyle}" Width="60" ToolTip="{DynamicResource str_tooltip_duration}"/>
                                    <TextBlock Text="∞" Foreground="{StaticResource TextMuted}" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DEPURACIÓN -->
                        <TextBlock Text="{DynamicResource str_label_debug}" Style="{StaticResource SectionLabel}"/>
                        <Border Background="#0E1823" CornerRadius="12" Padding="9" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ShowFFmpegCommand" Content="{DynamicResource str_show_ffmpeg_cmd}" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="SaveLogs" Content="{DynamicResource str_save_logs}" Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- Row 2: Perfiles de calidad + Action buttons -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="198"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource str_section_quality}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Choose a launch profile, then fine-tune the stream envelope below." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,3,0,10"/>
                            <UniformGrid Columns="5" Margin="0,2,0,0" Rows="1">
                                <Button x:Name="Profile480p" Style="{StaticResource ProfileCardButton}" Tag="480p" Click="ProfileButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="480p" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_480p_sub}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Profile720p" Style="{StaticResource ProfileCardButton}" Tag="720p" Click="ProfileButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="720p" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_720p_sub}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Profile1080p" Style="{StaticResource ProfileCardButtonActive}" Tag="1080p" Click="ProfileButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="1080p" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_1080p_sub}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Profile1080p60" Style="{StaticResource ProfileCardButton}" Tag="1080p60" Click="ProfileButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="1080p 60" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_1080p60_sub}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ProfileCustom" Style="{StaticResource ProfileCardButton}" Tag="custom" Click="ProfileButton_Click" Margin="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Custom" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource str_custom_sub}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Border Background="#0E1823" CornerRadius="14" Padding="12" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Style="{StaticResource FieldContainer}" Margin="0,0,10,0">
                                        <TextBlock Text="Video Bitrate" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="VideoBitrateManual" Text="4500k" Style="{StaticResource TextBoxStyle}" Width="112"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource FieldContainer}" Margin="10,0,10,0">
                                        <TextBlock Text="Audio Bitrate" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="AudioBitrateManual" Text="160k" Style="{StaticResource TextBoxStyle}" Width="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource FieldContainer}" Margin="0,0,10,0">
                                        <TextBlock Text="Preset" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="PresetCombo" Style="{StaticResource ComboBoxStyle}" SelectedIndex="4" Foreground="Black" Height="28">
                                            <ComboBoxItem Content="ultrafast"/>
                                            <ComboBoxItem Content="superfast"/>
                                            <ComboBoxItem Content="veryfast"/>
                                            <ComboBoxItem Content="faster"/>
                                            <ComboBoxItem Content="fast"/>
                                            <ComboBoxItem Content="medium"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{DynamicResource str_label_res_fps}" Style="{StaticResource LabelStyle}" Width="107"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ResolutionManual" Grid.Column="0" Text="1920x1080" Style="{StaticResource TextBoxStyle}" Grid.ColumnSpan="3" Margin="-2,4,44,4"/>
                                            <TextBlock Grid.Column="2" Text="@" VerticalAlignment="Center" Margin="19,0,30,0" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBox x:Name="FPSManual" Grid.Column="2" Text="30" Style="{StaticResource TextBoxStyle}" Margin="20,4,-10,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#0E1823" CornerRadius="14" Padding="12" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource str_schedule_title}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource str_schedule_hint}" Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource str_schedule_date}" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="ScheduleDateText" Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource str_schedule_time}" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="ScheduleTimeText" Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" x:Name="ScheduleStartBtn" Style="{StaticResource SecondaryButton}" Content="{DynamicResource str_schedule_set}" Padding="10,6" Margin="0,20,0,0" Click="ScheduleStartBtn_Click"/>
                                        <Button Grid.Column="6" x:Name="ScheduleCancelBtn" Style="{StaticResource DangerButton}" Content="{DynamicResource str_schedule_cancel}" Padding="10,6" Margin="0,20,0,0" Click="ScheduleCancelBtn_Click"/>
                                        <Border Grid.Column="7" Background="#101925" CornerRadius="12" Padding="10,8" Margin="14,0,0,0" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource str_schedule_state_label}" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontFamily="{DynamicResource MonoFont}"/>
                                                <TextBlock x:Name="ScheduleStatusText" Text="{DynamicResource str_schedule_none}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                <TextBlock x:Name="ScheduleCountdownText" Text="" Foreground="{StaticResource AccentYellow}" FontSize="10.5" FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons column -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Launch" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Start the configured stream or stop the current session." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Button x:Name="StartBig" Style="{StaticResource BigPrimaryButton}" Content="{DynamicResource str_start_stream}" Click="StartStream_Click" Width="Auto" Height="44" Margin="0,0,0,8"/>
                            <Button x:Name="StopBig" Style="{StaticResource BigDangerButton}" Content="{DynamicResource str_btn_stop}" Click="StopStream_Click" IsEnabled="False" Width="Auto" Height="44" Margin="0,0,0,10"/>
                            <Border Background="#0E1823" CornerRadius="14" Padding="9" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Session" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="{DynamicResource MonoFont}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="⏱" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="StreamTimeCompact" Text="00:00:00" Foreground="{StaticResource TextSecondary}" FontFamily="{DynamicResource MonoFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Ellipse x:Name="VideoHealthIndicator" Width="8" Height="8" Fill="{StaticResource StatusGreen}" Margin="0,0,6,0" Visibility="Hidden"/>
                                        <TextBlock x:Name="VideoHealthText" Text="{DynamicResource str_status_live}" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Hidden"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Overlay + Favoritos side by side -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Overlay / Logo -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🖼️ Overlay / Logo" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Brand the output with a logo and keep its placement predictable." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource str_label_image}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="OverlayPathText" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" ToolTip="{DynamicResource str_tooltip_png}"/>
                                <Button Grid.Column="2" x:Name="OverlayBrowseBtn" Content="{DynamicResource str_select}" Style="{StaticResource SecondaryButton}" Margin="8,0,4,0" Padding="8,4" Click="OverlayBrowseBtn_Click"/>
                                <Button Grid.Column="3" x:Name="OverlayClearBtn" Content="✕" Style="{StaticResource DangerButton}" Width="28" Height="28" Click="OverlayClearBtn_Click" ToolTip="{DynamicResource str_tooltip_clear_overlay}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource str_label_position}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="OverlayPositionCombo" Style="{StaticResource ComboBoxStyle}" Width="160" SelectedIndex="3">
                                        <ComboBoxItem Content="{DynamicResource str_pos_topleft}" Tag="10:10"/>
                                        <ComboBoxItem Content="{DynamicResource str_pos_topright}" Tag="W-w-10:10"/>
                                        <ComboBoxItem Content="{DynamicResource str_pos_bottomleft}" Tag="10:H-h-10"/>
                                        <ComboBoxItem Content="{DynamicResource str_pos_bottomright}" Tag="W-w-10:H-h-10"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource str_label_size}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                    <ComboBox x:Name="OverlaySizeCombo" Style="{StaticResource ComboBoxStyle}" Width="140" SelectedIndex="1">
                                        <ComboBoxItem Content="{DynamicResource str_size_small}" Tag="80"/>
                                        <ComboBoxItem Content="{DynamicResource str_size_medium}" Tag="130"/>
                                        <ComboBoxItem Content="{DynamicResource str_size_large}" Tag="200"/>
                                    </ComboBox>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="OverlayPreviewBorder" Background="#0D1621" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" CornerRadius="12" Width="76" Height="76" Margin="12,0,0,0" Visibility="Collapsed" ToolTip="{DynamicResource str_tooltip_logo_preview}">
                                    <Image x:Name="OverlayPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Favoritos -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource str_section_favorites}" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SaveFavoriteButton" Style="{StaticResource SecondaryButton}" Content="{DynamicResource str_save}" Padding="8,4" FontSize="12" Click="SaveFavorite_Click"/>
                                    <Button x:Name="DeleteFavoriteButton" Style="{StaticResource DangerButton}" Content="{DynamicResource str_delete}" Padding="8,4" FontSize="12" Margin="6,0,0,0" Click="DeleteFavorite_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Store reusable stream setups and load them quickly before going live." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,6,0,8"/>
                            <ListBox x:Name="FavoritesList" Background="#0D1621" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" Margin="0,10,0,0" SelectionChanged="FavoritesList_SelectionChanged" Foreground="{StaticResource TextPrimary}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended" MaxHeight="120" Padding="8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Últimos streams -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource str_section_history}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Recent sessions stay visible here for quick context and troubleshooting." Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,0,0,8"/>
                        <ListBox x:Name="HistoryList" Background="#0D1621" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FontFamily="{DynamicResource MonoFont}" MaxHeight="120" FontSize="12" Padding="8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
