<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Streamer.MainWindow"
        Title="Corillo.live Streamer Pro" 
        Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Colores como SolidColorBrush -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#161B22"/>
        <SolidColorBrush x:Key="BgCard" Color="#21262D"/>
        <SolidColorBrush x:Key="Accent" Color="#2F81F7"/>
        <SolidColorBrush x:Key="AccentHover" Color="#388BFD"/>
        <SolidColorBrush x:Key="Success" Color="#3FB950"/>
        <SolidColorBrush x:Key="Danger" Color="#F85149"/>
        <SolidColorBrush x:Key="Warning" Color="#D29922"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>

        <!-- Estilos -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D333B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource BgPrimary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con estado -->
        <Border Grid.Row="0" 
                Background="#161B22" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎥" FontSize="32" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Corillo.live Streamer Pro" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Streaming profesional con FFmpeg" 
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Estado FFmpeg -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border x:Name="FFmpegStatus"
                            Background="#21262D" 
                            CornerRadius="20" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FFmpegIndicator"
                                     Width="10" 
                                     Height="10" 
                                     Fill="{StaticResource Danger}" 
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="FFmpegStatusText"
                                       Text="FFmpeg: Buscando..." 
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,15">
            <StackPanel>
                <!-- Sección: Configuración básica -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🔧 Configuración básica" 
                                   Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- RTMP Base -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="RTMP Base URL" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="RTMPBase" 
                                         Text="rtmp://corillo.live/live/" 
                                         Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>

                            <!-- Stream Key -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="Stream Key" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="StreamKey" 
                                         Text="" 
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="Ej: openmovies, katatonia, etc"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fuente -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Fuente de video" 
                                       Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="SourceCombo" 
                                      Style="{StaticResource ComboBoxStyle}" 
                                      Height="40"
                                      SelectedIndex="0" SelectionChanged="SourceCombo_SelectionChanged">
                                <ComboBoxItem Content="Tears of Steel - Sci-fi corto (open)"/>
                                <ComboBoxItem Content="Big Buck Bunny - Animación (open)"/>
                                <ComboBoxItem Content="Elephant's Dream - Open movie clásico"/>
                                <ComboBoxItem Content="Sintel - Fantasy (open)"/>
                                <ComboBoxItem IsEnabled="False" Content="--- 4K Samples ---"/>
                                <ComboBoxItem Content="For Bigger Blazes - 4K Sample"/>
                                <ComboBoxItem Content="For Bigger Escape - 4K Sample"/>
                                <ComboBoxItem IsEnabled="False" Content="--- Test Patterns ---"/>
                                <ComboBoxItem Content="Test Pattern (Color bars)"/>
                                <ComboBoxItem Content="SMPTE Color Bars"/>
                                <ComboBoxItem Content="Black Screen"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Info del video -->
                        <Border Background="#161B22" 
                                CornerRadius="6" 
                                Padding="15" 
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Resolución" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="VideoResolution" 
                                               Text="1920x1080" 
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FPS" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="VideoFPS" 
                                               Text="30" 
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Codec" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="VideoCodec" 
                                               Text="H.264" 
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Bitrate" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="VideoBitrateInfo" 
                                               Text="4500k" 
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sección: Perfiles de calidad -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="⚡ Perfiles de calidad" 
                                   Style="{StaticResource SectionTitle}"/>

                        <WrapPanel Margin="0,0,0,15">
                            <Button x:Name="Profile480p"
                                    Style="{StaticResource SecondaryButton}" 
                                    Content="Baja (480p) - 1000k" 
                                    Margin="0,0,5,5"
                                    Tag="480p"
                                    Click="ProfileButton_Click"/>
                            <Button x:Name="Profile720p"
                                    Style="{StaticResource PrimaryButton}" 
                                    Content="Media (720p) - 2500k" 
                                    Margin="0,0,5,5"
                                    Tag="720p"
                                    Click="ProfileButton_Click"/>
                            <Button x:Name="Profile1080p"
                                    Style="{StaticResource SecondaryButton}" 
                                    Content="Alta (1080p) - 4500k" 
                                    Margin="0,0,5,5"
                                    Tag="1080p"
                                    Click="ProfileButton_Click"/>
                            <Button x:Name="Profile1080p60"
                                    Style="{StaticResource SecondaryButton}" 
                                    Content="Alta+ (1080p60) - 5000k" 
                                    Margin="0,0,5,5"
                                    Tag="1080p60"
                                    Click="ProfileButton_Click"/>
                            <Button x:Name="Profile4k"
                                    Style="{StaticResource SecondaryButton}" 
                                    Content="Ultra (4K) - 16000k" 
                                    Margin="0,0,5,5"
                                    Tag="4k"
                                    Click="ProfileButton_Click"/>
                            <Button x:Name="ProfileCustom"
                                    Style="{StaticResource SecondaryButton}" 
                                    Content="Personalizado..." 
                                    Margin="0,0,5,5"
                                    Click="ProfileCustom_Click"/>
                        </WrapPanel>

                        <!-- Configuración manual -->
                        <Border Background="#161B22" CornerRadius="6" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Video Bitrate" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="VideoBitrateManual" 
                                             Text="2500k" 
                                             Style="{StaticResource TextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Audio Bitrate" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="AudioBitrateManual" 
                                             Text="128k" 
                                             Style="{StaticResource TextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Preset x264" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="PresetCombo" 
                                              Style="{StaticResource ComboBoxStyle}" 
                                              SelectedIndex="2">
                                        <ComboBoxItem Content="ultrafast"/>
                                        <ComboBoxItem Content="superfast"/>
                                        <ComboBoxItem Content="veryfast"/>
                                        <ComboBoxItem Content="faster"/>
                                        <ComboBoxItem Content="fast"/>
                                        <ComboBoxItem Content="medium"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Resolución/FPS" Style="{StaticResource LabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ResolutionManual" 
                                                 Grid.Column="0" 
                                                 Text="1280x720" 
                                                 Style="{StaticResource TextBoxStyle}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="@" 
                                                   VerticalAlignment="Center"
                                                   Margin="5,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="FPSManual" 
                                                 Grid.Column="2" 
                                                 Text="30" 
                                                 Style="{StaticResource TextBoxStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sección: Opciones avanzadas -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="⚙️ Opciones avanzadas" 
                                   Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ForceYUV"
                                          Content="Forzar yuv420p" 
                                          IsChecked="True"
                                          Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="HardwareAccel"
                                          Content="Hardware acceleration" 
                                          Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="LoopInfinite"
                                          Content="Loop infinito" 
                                          IsChecked="True"
                                          Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ShowFFmpegCommand"
                                          Content="Mostrar comando FFmpeg" 
                                          Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="SaveLogs"
                                          Content="Guardar logs" 
                                          Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox x:Name="Notifications"
                                          Content="Notificaciones" 
                                          IsChecked="True"
                                          Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duración límite (segundos)" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="MaxDuration" 
                                         Text="0" 
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="0 = infinito"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección: Favoritos -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⭐ Favoritos" 
                                       Style="{StaticResource SectionTitle}"/>

                            <Button Grid.Column="1" 
                                    x:Name="SaveFavoriteButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Guardar actual"
                                    Padding="10,5"
                                    FontSize="11"
                                    Click="SaveFavorite_Click"/>
                        </Grid>

                        <ListBox x:Name="FavoritesList"
                                 Background="#161B22" 
                                 BorderThickness="0"
                                 Height="80"
                                 Margin="0,0,0,10"
                                 SelectionChanged="FavoritesList_SelectionChanged"/>

                        <TextBlock Text="📋 Últimos streams" 
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,10,0,10"/>

                        <ListBox x:Name="HistoryList"
                                 Background="#161B22" 
                                 BorderThickness="0"
                                 Height="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer con controles -->
        <Border Grid.Row="2" 
                Background="#161B22" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Estado del stream -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StreamStatus"
                             Width="12" 
                             Height="12" 
                             Fill="{StaticResource Danger}" 
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="StreamStatusText" 
                               Text="Detenido" 
                               Foreground="{StaticResource Danger}"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>

                    <TextBlock x:Name="StreamTime" 
                               Text="Tiempo: 00:00:00" 
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <!-- Botones de control -->
                <Button Grid.Column="1" 
                        x:Name="StartButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="🎬 Iniciar Stream"
                        Width="150"
                        Margin="0,0,10,0"
                        Click="StartStream_Click"/>

                <Button Grid.Column="2" 
                        x:Name="StopButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="⏹️ Detener"
                        Width="100"
                        IsEnabled="False"
                        Click="StopStream_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>